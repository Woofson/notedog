# 🐶 NOTEDOG CONFIGURATION EXAMPLE
# Location: ~/.config/notedog/notedog.toml or ~/.config/notedog/notedog.conf

# Directory where your notebooks, sections, and markdown notes are stored.
# Hierarchical layout: note_folder / Notebook / Section / Note.md
note_folder = "~/Notes"

# Default text editor for editing notes.
# Options: "builtin" (built-in TUI editor), "nvim", "vim", "nano", "micro", "helix"
editor = "builtin"

# Location for optional secrets & encrypted note keys
secrets_file = "~/.config/notedog/secrets.toml"

# Terminal background transparency.
# Set true for transparent terminals (uses default terminal background).
transparent_background = true

# Show bottom status and keybinding bar (true / false)
show_help_bar = true

# Default word wrap mode in Note Viewer (true / false)
word_wrap = true

# Default active notebook on launch
default_notebook = "Personal"

# 📝 DEFAULT TITLE TEMPLATES & DATE FORMATTING
# Used when creating new Notes (Ctrl+N) or Sections (Ctrl+K) with blank input
default_note_prefix = "Note "
default_note_postfix = ""
default_section_prefix = "Section "
default_section_postfix = ""
date_format = "%Y-%m-%d %H:%M"

# 🎨 CUSTOMIZABLE SECTION ICONS
[icons]
notebook = "📚 "
section = "📂 "
note = "📄 "
encrypted_note = "🔒 "
preview = "📖 "
editor = "✏️ "

# 🎨 HUMAN-UNDERSTANDABLE THEME CONFIGURATION
[theme]
active_border = "#FFCC66"         # Main active pane border color (Ayu Gold)
inactive_border = "#242936"       # Inactive pane border color (Ayu Charcoal Slate)
sidebar_title = "#36A3D9"         # Sidebar section headers title color (Ayu Cyan)
active_sidebar_border = "#FF7733" # Active sidebar pane border color (Ayu Coral Orange)
foreground = "#B3B1AD"           # Default text foreground color (Soft Off-White / Grey)
background = "none"              # Canvas background ("none" for transparent, or "#0F1419")
highlight_bg = "#1F2430"         # Selected list item background fill (Dark Slate)
highlight_fg = "#36A3D9"         # Selected list item text color (Ayu Cyan)
encrypted_tag = "#F07178"        # Encrypted note tag & lock badge color (Coral Red)

# 🖌️ INDIVIDUAL ITEM TEXT COLOR & FONT WEIGHT OVERRIDES (OPTIONAL)
# Colors: Hex code like "#B3B1AD", "gray", "white", "#36A3D9", etc.
# Weights: "normal", "bold", "dim", "italic", "underlined"

# -- Notebook Items
# notebook_item_fg = "#B3B1AD"
# notebook_item_weight = "normal"
# notebook_item_selected_fg = "#36A3D9"
