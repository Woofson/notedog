# 🐶 NOTEDOG CONFIGURATION EXAMPLE
# Location: ~/.config/notedog/notedog.toml or ~/.config/notedog/notedog.conf

# Directory where your notebooks, sections, and markdown notes are stored.
# Hierarchical layout: note_folder / Notebook / Section / Note.md
note_folder = "~/Notes"

# Default text editor for editing notes.
# Options: "builtin" (built-in TUI editor), "nvim", "vim", "nano", "micro", "helix"
editor = "builtin"

# Location for optional secrets & encrypted note keys
secrets_file = "~/.config/notedog/secrets.toml"

# Terminal background transparency.
# Set true for transparent terminals (uses default terminal background).
transparent_background = true

# Show bottom status and keybinding bar (true / false)
show_help_bar = true

# Default word wrap mode in Note Viewer (true / false)
word_wrap = true

# Default active notebook on launch (used as fallback when remember_last_session is false)
default_notebook = "Personal"

# Remember last active notebook, section, and note on exit & reopen (true / false)
# When true, NoteDog automatically reopens the exact note and pane you were last working on.
remember_last_session = true

# Auto-generate example configs (notedog.toml.example, theme.toml.example).
# Set false to disable NoteDog from re-spawning .example files in your config folder.
spawn_examples = true

# Auto-populate ~/.config/notedog/themes/ with built-in theme presets on startup.
# Set false if you manage your own themes directory and don't want built-in files auto-spawned.
spawn_themes = true

# 🎨 ACTIVE THEME SELECTION
# Themes are stored as separate .toml files in ~/.config/notedog/themes/
# To change themes, simply change this entry to any theme file name:
#
# Built-in themes automatically generated in ~/.config/notedog/themes/:
#   - "notedog"              (Default NoteDog warm gold & cyan theme)
#   - "nord"                 (Arctic blue & polar night)
#   - "catppuccin-mocha"     (Soothing dark pastel theme)
#   - "catppuccin-latte"     (Crisp light theme)
#   - "catppuccin-macchiato" (Medium dark pastel theme)
#   - "catppuccin-frappe"    (Muted dark pastel theme)
#   - "dracula"              (Vibrant purple/pink/cyan dark theme)
#   - "gruvbox"              (Retro groove warm contrast theme)
#   - "tokyo-night"          (Tokyo cyberpunk neon dark theme)
#   - "ayu-dark"             (Classic Ayu dark slate theme)
#   - "solarized-dark"       (Precision teal/blue low-contrast theme)
#   - "monokai"              (Classic vibrant high-contrast theme)
theme = "notedog"

# 📝 DEFAULT TITLE TEMPLATES & DATE FORMATTING
# Used when creating new Notes (Ctrl+N) or Sections (Ctrl+K) with blank input
default_note_prefix = "Note "
default_note_postfix = ""
default_section_prefix = "Section "
default_section_postfix = ""
date_format = "%Y-%m-%d %H:%M"

# 📐 RESIZABLE LAYOUT DIMENSIONS (PERCENTAGE OR FIXED ROWS/COLUMNS)
[layout]
sidebar_width = "26%"      # e.g. "26%" or "30" fixed columns
notebooks_height = "26%"   # e.g. "26%" or "8" fixed rows
sections_height = "34%"    # e.g. "34%" or "10" fixed rows
notes_height = "40%"       # e.g. "40%" or "12" fixed rows

# 🏷️ CUSTOMIZABLE PANE TITLES (SIDEBAR HEADERS & MAIN VIEW)
[titles]
notebooks = "NOTEBOOKS"     # Title text for Notebooks pane
sections = "SECTIONS"       # Title text for Sections pane
notes = "NOTES"             # Title text for Notes pane
show_main_title = false     # Set true to show note title at the top of the main viewer/editor pane

# 🎨 CUSTOMIZABLE SECTION ICONS & PRESET REGEX MATCHING RULES
# Note: Color Emojis (📚 📂 📄 🔒) use your terminal's fixed font color artwork.
# For full custom icon coloring via `notebook_icon_fg`, use Nerd Fonts symbols below!
#
# Rules support optional `target` scoping:
# target = "notebook"  -> only applies to notebooks
# target = "section"   -> only applies to sections
# target = "note"      -> only applies to notes
# (omitted / "all")   -> applies to all three as general fallback
[icons]
# Standard Color Emojis:
notebook = "📚 "
section = "📂 "
note = "📄 "
encrypted_note = "🔒 "
preview = "📖 "
editor = "✏️ "
# Markdown Header Icons (Change pin/bullet icon or set to "" to disable):
header_1 = "📌 "     # Header 1 icon (pin). Set to "" or "# " or custom Nerd Font icon
header_2 = "🔸 "     # Header 2 icon
header_3 = "🔹 "     # Header 3 icon

# Nerd Fonts Alternatives (Supports full custom RGB / Hex coloring!):
# notebook = "󰉋 "
# section = " "
# note = "󰈙 "
# encrypted_note = "󰌾 "
# preview = "📖 "
# editor = "✏️ "
# header_1 = "󰌹 "    # Nerd Font pin icon
# header_2 = "󰄾 "
# header_3 = "󰅂 "

# 📋 TODO & TASKLIST PRESETS
[[icons.rules]]
pattern = "(?i).*(todo|tasks|tasklist|checklist|to-do).*"
icon = "✅ "

# 🛒 SHOPPING & GROCERY LIST PRESETS (General rule)
[[icons.rules]]
pattern = "(?i).*(shopping|grocery|groceries|store|buy|buy-list).*"
icon = "🛒 "

# 🥦 SCOPED EXAMPLE: Specific icon for a note named groceries vs section
# [[icons.rules]]
# pattern = "(?i).*groceries.*"
# target = "note"
# icon = "🥦 "


# 💡 IDEAS & BRAINSTORMING
[[icons.rules]]
pattern = "(?i).*(idea|ideas|brainstorm|concept).*"
icon = "💡 "

# 💼 WORK & PROJECTS
[[icons.rules]]
pattern = "(?i).*(work|job|office|project|sprint).*"
icon = "💼 "

# 📔 PERSONAL & JOURNAL
[[icons.rules]]
pattern = "(?i).*(personal|journal|diary|daily).*"
icon = "📔 "

# 💰 FINANCE & BUDGET
[[icons.rules]]
pattern = "(?i).*(finance|budget|money|expense|expenses|bank).*"
icon = "💰 "

# 🔒 SECRETS & VAULT
[[icons.rules]]
pattern = "(?i).*(secret|secrets|passwords|vault|private).*"
icon = "🔒 "

# 📅 MEETINGS & CALLS
[[icons.rules]]
pattern = "(?i).*(meeting|meetings|call|agenda|standup).*"
icon = "📅 "

# 👋 WELCOME & INTRO
[[icons.rules]]
pattern = "(?i).*(welcome|intro|getting-started|readme).*"
icon = "👋 "

# 📝 CUSTOM NOTE TEMPLATE RULES (OPTIONAL)
[[templates]]
pattern = "(?i).*(sprint|retro).*"
template = """# 🚀 {{title}}

**Date**: {{date}}

## 🟢 What Went Well
- 

## 🔴 What Needs Improvement
- 

## ⚡ Action Items
- [ ] 
"""

